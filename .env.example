# ── Banco de dados ─────────────────────────────────────────────
# Local:
DATABASE_URL=postgres://rota:rota@localhost:5432/rota_dev
# Supabase (produção, na Vercel): Project Settings → Database → Connection string
#   DATABASE_URL           = "Transaction pooler" (porta 6543)  → usado pelo app
#   DATABASE_URL_MIGRACAO  = "Session pooler"     (porta 5432)  → usado nas migrações
#   DATABASE_CA_CERT       = conteúdo do certificado SSL (Settings → Database → SSL Configuration) — recomendado
# DATABASE_URL_MIGRACAO=
# DATABASE_CA_CERT=

# Banco usado pelos testes automáticos (é APAGADO a cada execução)
DATABASE_URL_TEST=postgres://rota:rota@localhost:5432/rota_test

# ── Primeiro acesso em produção ────────────────────────────────
# Cria o admin no primeiro deploy (se ainda não houver admin). Apague depois de entrar.
# ADMIN_INICIAL_NOME=Seu Nome
# ADMIN_INICIAL_EMAIL=voce@seudominio.com.br
# ADMIN_INICIAL_SENHA=uma-senha-forte-com-10+-caracteres
